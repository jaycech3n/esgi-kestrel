(ld "list-defs.lisp")

; --- rev ---

(defthm rev-all-equal
  (iff (all-equalp v (rev xs))
       (all-equalp v xs)))

; --- dropvals ---

(defthm dropvals-last-ne-val
  (implies (not (equal x v))
           (consp (dropvals v (append xs (list x)))))
  :hints (("Goal" :induct (len xs))))

(defthm consp-dropvals-append
  (implies (consp (dropvals v xs))
           (consp (dropvals v (append xs ys)))))

(defthm dropvals-all
  (implies (all-equalp v xs)
           (not (dropvals v xs)))
  :hints (("Goal" :cases (true-listp xs))))

(defthm dropvals-from-end-all
  (implies (all-equalp v xs)
           (not (dropvals-from-end v xs))))
